# Application configuration uses the PI_CHAT_ prefix.
# The optional Claude Code provider settings below use the package's own prefix.

# Server
PI_CHAT_PORT=4000

# Pi
PI_CHAT_PROJECT_DIR=
# Built-in Pi model or pi-claude-code model, e.g. claude-code/default:medium.
PI_CHAT_MODEL=
# Required for built-in providers; ignored for claude-code (uses the CLI login).
PI_CHAT_PROVIDER_API_KEY=
# Required TypeSafe AI key for Jev question routing.
PI_CHAT_JEV_API_KEY=
# Optional Brave Search API key. On exe.dev, an attached `brave` integration is
# discovered automatically when this is blank.
PI_CHAT_BRAVE_SEARCH_API_KEY=
# Optional Firecrawl API key for fresh full-page fetching. On exe.dev, an attached
# `firecrawl` integration is discovered automatically; otherwise keyless limits apply.
PI_CHAT_FIRECRAWL_API_KEY=
# Required comma-separated hostname allowlist, e.g. docs.example.com,support.example.com.
PI_CHAT_WEB_SEARCH_DOMAINS=

# Platform adapters
PI_CHAT_SLACK_BOT_TOKEN=
PI_CHAT_SLACK_SIGNING_SECRET=

# State adapters
PI_CHAT_POSTGRES_URL=postgresql://localhost:5432/postgres

# Claude Code provider (optional; only used for PI_CHAT_MODEL=claude-code/...).
# Install the CLI separately and run `claude auth login` on this host.
# Defaults to `claude` on PATH and the CLI's normal configuration directory.
PI_CLAUDE_CODE_COMMAND=
PI_CLAUDE_CODE_CONFIG_DIR=
