# Every variable this project reads carries the PI_CHAT_ prefix. That is what
# keeps them out of the environment handed to the delegated Claude Code session.

# Server
PI_CHAT_PORT=4000

# Pi
PI_CHAT_PROJECT_DIR=
PI_CHAT_MODEL=
PI_CHAT_PROVIDER_API_KEY=
# Required TypeSafe AI key for Jev question routing.
PI_CHAT_JEV_API_KEY=
# Optional Brave Search API key. On exe.dev, an attached `brave` integration is
# discovered automatically when this is blank.
PI_CHAT_BRAVE_SEARCH_API_KEY=
# Optional Firecrawl API key for fresh full-page fetching. On exe.dev, an attached
# `firecrawl` integration is discovered automatically; otherwise keyless limits apply.
PI_CHAT_FIRECRAWL_API_KEY=
# Required comma-separated hostname allowlist, e.g. docs.example.com,support.example.com.
PI_CHAT_WEB_SEARCH_DOMAINS=

# Platform adapters
PI_CHAT_SLACK_BOT_TOKEN=
PI_CHAT_SLACK_SIGNING_SECRET=

# State adapters
PI_CHAT_POSTGRES_URL=postgresql://localhost:5432/postgres

# Claude delegation (all optional; delegation runs the Claude Code CLI installed
# on this machine, with the credentials that CLI already has)
PI_CHAT_CLAUDE_MODEL=
PI_CHAT_CLAUDE_EFFORT=
PI_CHAT_CLAUDE_MAX_TURNS=
# Cost ceiling per delegation, in USD. Defaults to 5; `off` removes it.
PI_CHAT_CLAUDE_MAX_BUDGET_USD=
# Wall-clock ceiling per delegation, in milliseconds. Defaults to 600000.
PI_CHAT_CLAUDE_TIMEOUT_MS=
