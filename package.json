{
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "start": "node --env-file=.env --experimental-strip-types src/index.ts",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint --deny-warnings && oxfmt --check",
    "lint:fix": "oxlint --fix && oxfmt",
    "prepare": "node .husky/install.mjs"
  },
  "dependencies": {
    "@chat-adapter/slack": "4.45.0",
    "@chat-adapter/state-pg": "4.45.0",
    "@earendil-works/pi-ai": "^1.6.0",
    "@earendil-works/pi-claude-code": "git+https://github.com/earendil-works/pi-claude-code.git#47f9e2bb408f8b5c351edf95f7b756bc5c8f45cf",
    "@earendil-works/pi-coding-agent": "^1.6.0",
    "@earendil-works/pi-tui": "^1.6.0",
    "@goofansu/pi-web": "1.0.1",
    "@slack/web-api": "^8.4.0",
    "@typesafe-ai/sdk": "0.7.0",
    "chat": "4.45.0",
    "typebox": "^1.4.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "husky": "^9.1.7",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "typescript": "^7.0.2"
  }
}
